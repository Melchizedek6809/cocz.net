    "test": "npm run typecheck:fe && npm run typecheck:be"
  },
  "dependencies": {
    "express": "latest",
    "markdown-it": "latest",
    "markdown-it-highlightjs": "latest",
    "vite": "latest",
    "yaml": "latest"
  },
  "devDependencies": {
    "@types/express": "latest",
    "@types/markdown-it": "latest",
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
