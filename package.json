{
  "name": "cocz.net",
  "version": "1.0.0",
  "description": "Ben's custom SSG / Blog",
  "type": "module",
  "scripts": {
    "dev": "tsx --watch src/server.ts",
    "build": "node --import tsx src/build.ts",
    "build:vite": "vite build",
    "preview": "vite preview",
    "typecheck:fe": "tsc --noEmit",
